# Lore source to back up. Set this to the production Lore repository.
LORE_REMOTE=lore://172.20.12.193:41337/gamestudio/UnrealEngine
LORE_BRANCH=main
LORE_BIN=/datadrive/lore/bin/lore

# Git destination. Use an SSH remote or a credential helper that works
# non-interactively for the service account.
GIT_REMOTE=git@github.com:YOUR-ORGANIZATION/UnrealEngine-lore-backup.git
GIT_BRANCH=main

# This host-local working state is not the backup destination. It contains a
# Lore clone and a Git clone, and must be writable only by the service account.
BACKUP_ROOT=/datadrive/lore-git-backup

# The Git committer represents the scheduled conversion, while Git author data
# is derived from each Lore revision's authenticated creator.
GIT_COMMITTER_NAME=Lore Backup Bot
GIT_COMMITTER_EMAIL=lore-backup@gamestudio.co.jp

# Must exceed the number of source-branch revisions that may remain unbacked
# up. Increase it before the current branch history reaches this value.
MAX_HISTORY=100000
